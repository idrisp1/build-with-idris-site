PORT=8095
NODE_ENV=development

# Origin this server is reachable at. Same origin serves both the site and the
# API, so this only matters for CORS (no trailing slash).
FRONTEND_ORIGIN=http://127.0.0.1:8095

# Required: admin login (this is what you sign in with on the site itself,
# there is no separate admin page/URL). Demo credentials below are
# username "admin", password "admin123", change ADMIN_PASSWORD_HASH before
# any real deployment by running:
#   node backend/scripts/hash-password.js "your-new-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$9Ji0EMOAdt4Mt/eb24t71u58o34WTAhwhsUrXUb79Tm/LEZUVm/kW

# Required: any long random string, used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me

# ---------------------------------------------------------------------------
# SEO & AI-discovery engine (backend/seo_engine). Everything below is
# optional: unset integrations are skipped and reported in the admin
# "SEO Engine" panel. Set these in the Railway dashboard, never in git.
# ---------------------------------------------------------------------------
# Google Search Console (same service account as the Search Insights panel).
# GSC_SITE_URL=https://buildwithidris.com/
# GSC_SERVICE_ACCOUNT_JSON={...full JSON key on one line...}

# Bing Webmaster Tools API key (Bing Webmaster Tools -> Settings -> API access)
# BING_WEBMASTER_API_KEY=
# Optional, only if you verify Bing with the meta-tag method:
# BING_SITE_VERIFICATION=

# IndexNow: key is generated and stored automatically; override only if needed
# INDEXNOW_KEY=
# INDEXNOW_ENABLED=true             # default: on in production, off elsewhere

# Scheduler: default on in production, off in local development
# SEO_SCHEDULER_ENABLED=true

# Competitor content-gap analysis (owner-chosen homepages, comma-separated)
# SEO_COMPETITOR_URLS=https://example-competitor-1.com,https://example-competitor-2.com
