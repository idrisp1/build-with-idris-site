PORT=8095
NODE_ENV=development

# Origin this server is reachable at. Same origin serves both the site and the
# API, so this only matters for CORS (no trailing slash).
FRONTEND_ORIGIN=http://127.0.0.1:8095

# Required: admin login (this is what you sign in with on the site itself,
# there is no separate admin page/URL). Demo credentials below are
# username "admin", password "admin123", change ADMIN_PASSWORD_HASH before
# any real deployment by running:
#   node backend/scripts/hash-password.js "your-new-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$9Ji0EMOAdt4Mt/eb24t71u58o34WTAhwhsUrXUb79Tm/LEZUVm/kW

# Required: any long random string, used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me
